# ADHDPunt – Apache configuration for TransIP webhosting (static prerendered site)
# Every public page exists as a prerendered file: /contact -> contact.html, / -> index.html.
# Unknown URLs get HTTP 404 with the client-side app shell (_shell.html), which renders the 404 page.

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType application/xml .xml
AddType image/svg+xml .svg
AddType font/woff .woff

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Never redirect Let's Encrypt validation requests (needed for SSL renewal).
  RewriteRule ^\.well-known/ - [L]

  # External redirects below skip internal sub-requests (e.g. the 404 error document): REDIRECT_STATUS.
  # 1. Force HTTPS (enable SSL in the TransIP control panel first).
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. www.adhdpunt.nl -> adhdpunt.nl (canonical URLs in the HTML use https://adhdpunt.nl).
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{HTTP_HOST} ^www\.adhdpunt\.nl$ [NC]
  RewriteRule ^ https://adhdpunt.nl%{REQUEST_URI} [L,R=301]

  # 3. Clean URLs: /index.html -> /, /contact.html -> /contact (only for direct client requests).
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [L,R=301]
  # (%1 comes from the last condition, so the capturing condition must stay last.)
  RewriteCond %{REQUEST_URI} !^/_shell\.html$
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [L,R=301]

  # 4. Remove trailing slash from page URLs (/contact/ -> /contact), not from real folders.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [L,R=301]

  # 4b. Short address for the patient questionnaire: /vzah shows the same page as the unlisted
  #     questionnaire URL (the address bar keeps /vzah). Both addresses keep working.
  RewriteRule ^vzah$ vragenlijst-2ygyerc2.html [L,NC]

  # 5. Serve the prerendered page for clean URLs (works for nested routes too: /a/b -> a/b.html).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# 6. SPA fallback: anything else is a 404 rendered by the app (keeps the real 404 status for SEO).
ErrorDocument 404 /_shell.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Hashed build assets never change: cache for one year.
  <FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Unlisted patient questionnaires (vragenlijst-*.html): never index, no referrer.
  <FilesMatch "^vragenlijst-.*\.html$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Referrer-Policy "no-referrer"
  </FilesMatch>
  # HTML, sitemap and robots must always be revalidated so new deploys show up immediately.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
